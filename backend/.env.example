# ─── Environment ───
NODE_ENV=development
PORT=5000

# ─── MongoDB ───
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ───
# Use long random secrets (32+ chars) in production.
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-separate-super-secret-refresh-key-change-this-in-production

# ─── Google OAuth ───
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Razorpay ───
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ─── Super Admin (auto-promoted on first Google login) ───
SUPER_ADMIN_EMAIL=shubhojitsarkar50@gmail.com

# ─── Frontend URL (for CORS) ───
# Comma-separated for multiple origins
# In production, use HTTPS origins only.
FRONTEND_URL=http://localhost:5173
